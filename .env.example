# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
# Comma-separated Telegram user ids allowed to control the bot.
# Leave empty to claim ownership with /claim CODE (the one-time code is printed in the service log).
TELEGRAM_OWNER_IDS=
# Bot wallet file created by `npm run new-wallet` (keep it out of git, mode 600)
WALLET_PATH=secrets/wallet.json
# SQLite database for runs, ledger, settings and events
DB_PATH=data/bot.db
# In-game username, set automatically on the very first login (only needed once)
MOG_USERNAME=
# Expedition Pass referral code applied when the bot buys a pass.
# Empty = use the project default (see README "Referral"). Put your own code here, or set it to
# "none" to disable referrals entirely.
REFERRAL_CODE=
# Client version header the game expects (bump if the server answers CLIENT_OUTDATED)
MOG_APP_VERSION=24
# 2captcha.com key. REQUIRED to play: the game gates starting and joining a run behind a
# Cloudflare Turnstile human check, and this key lets the bot solve it. Without it the bot
# logs in and claims rewards but cannot run. Get one at https://2captcha.com (top up a little balance).
TWOCAPTCHA_API_KEY=
# Optional 2captcha soft_id (developer/affiliate id). Leave empty.
TWOCAPTCHA_SOFT_ID=
# Page the Turnstile is bound to. Leave as-is unless the game moves domains.
MOG_VERIFY_PAGEURL=https://playmog.xyz
LOG_LEVEL=info
# Research hook: set to 1 to dump raw game state during storm weather (large logs, normally off)
STORM_PROBE=0
