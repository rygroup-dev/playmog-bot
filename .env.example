# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
# Comma-separated Telegram user ids allowed to control the bot.
# Leave empty to claim ownership with /claim CODE (the one-time code is printed in the service log).
TELEGRAM_OWNER_IDS=
# Bot wallet file created by `npm run new-wallet` (keep it out of git, mode 600)
WALLET_PATH=secrets/wallet.json
# SQLite database for runs, ledger, settings and events
DB_PATH=data/bot.db
# In-game username, set automatically on the very first login (only needed once)
MOG_USERNAME=
# Client version header the game expects (bump if the server answers CLIENT_OUTDATED)
MOG_APP_VERSION=24
LOG_LEVEL=info
